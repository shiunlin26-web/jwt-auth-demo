{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://jwt-auth-demo-backend.onrender.com/api/:path*"
    },
    {
      "source": "/echo/:path*",
      "destination": "https://httpbin.org/:path*"
    },
    {
      "source": "/((?!api/|echo/).*)",
      "destination": "/index.html"
    }
  ]
}
