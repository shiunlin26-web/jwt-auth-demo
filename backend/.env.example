# ===== 必填 =====

# 資料庫連線字串（開頭要是 postgresql+asyncpg://，Neon 用 ssl=require）
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# JWT 簽章金鑰，至少 32 個字元。產生方式：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=請換成至少32個字元的隨機字串

# ===== 選填（以下都是預設值，不寫也可以）=====

# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# 允許呼叫 API 的前端網址，多個用逗號分隔
# CORS_ORIGINS=http://localhost:5173

# refresh token cookie 只走 HTTPS（本機 http 要 false，正式環境 true）
# COOKIE_SECURE=false

# 在 terminal 印出每一句 SQL（學習時可以打開看看）
# DB_ECHO=false
