# ===== 必填 =====

# 資料庫連線字串（開頭要是 postgresql+asyncpg://，Neon 用 ssl=require）
DATABASE_URL=postgresql+asyncpg://user:password@host/dbname?ssl=require

# JWT 簽章金鑰，至少 32 個字元。產生方式：
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=請換成至少32個字元的隨機字串

# ===== 選填（以下都是預設值，不寫也可以）=====

# JWT_ALGORITHM=HS256
# JWT_EXPIRE_MINUTES=30
# REFRESH_TOKEN_EXPIRE_DAYS=7

# 允許呼叫 API 的前端網址，多個用逗號分隔。
# 【關卡 10 起】前端經過 Vite / Vercel 代理，對瀏覽器來說是同一個網站，平常用不到 CORS；
# 只有前端設了 VITE_API_URL 直接打後端時才需要
# CORS_ORIGINS=http://localhost:5173

# refresh token cookie 只走 HTTPS（本機 http 要 false，正式環境 true）
# COOKIE_SECURE=false

# 在 terminal 印出每一句 SQL（學習時可以打開看看）
# DB_ECHO=false

# ===== 維護相關（關卡 11）=====

# log 等級與格式。本機看文字，正式環境（render.yaml）用 JSON
# LOG_LEVEL=INFO
# LOG_JSON=false

# Sentry 錯誤追蹤的 DSN。本機通常不設；正式環境到 Render 的 Environment 加
# SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# 開放除錯端點 /api/_boom（故意丟例外，測 log 與 Sentry）、/api/_ip（看頻率限制算到哪個 IP）。演練時才打開
# ENABLE_DEBUG_ENDPOINTS=false

# ===== 可觀測性（關卡 22）=====

# 開放 /metrics 給 Prometheus 抓。本機想看就設 true 後開 http://localhost:8000/metrics；compose 裡已經打開；
# 線上不用設（/metrics 不在 /api 底下，Vercel 不會轉發）
# METRICS_ENABLED=false

# ===== 頻率限制（關卡 17）=====

# 登入與註冊每個 IP 的上限；本機想關掉就 RATE_LIMIT_ENABLED=false
# RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT=10/minute
# 前面有幾層可信的代理（本機 0、只有 Render 1、Vercel + Render 2），說明見 rate_limit.py
# TRUSTED_PROXY_HOPS=0

# ===== 跑測試才需要（關卡 4）=====

# 測試專用資料庫。測試每次都會「清空資料表」，絕對不能和 DATABASE_URL 用同一個！
# Neon：到 SQL Editor 執行 CREATE DATABASE jwtdemo_test; 再把連線字串的資料庫名稱換成 jwtdemo_test
# TEST_DATABASE_URL=postgresql+asyncpg://user:password@host/jwtdemo_test?ssl=require
