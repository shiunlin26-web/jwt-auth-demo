# 【關卡 13】告訴每一種編輯器（VS Code、JetBrains、Vim……）基本的排版規則，開檔案就自動套用。
# Prettier、ruff format 管的是「存檔後」的格式；這個管的是「打字時」的縮排與換行，兩者互補。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

# PowerShell 5.1 讀沒有 BOM 的檔案會用系統 ANSI 編碼，中文註解會變亂碼甚至造成語法錯誤
[*.ps1]
charset = utf-8-bom
